    <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
        <column_headers>
            <data>Command</data>
        </column_headers>
        <row>
            <data>create_clock -name {free_clk} [get_ports {free_clk}] -period {40.000} -waveform {0.000 20.000}</data>
        </row>
        <row>
            <data>create_generated_clock -name {clk_50m} -source [get_ports {free_clk}] [get_nets {ov5640_clk.clkout0}] -master_clock [get_clocks {free_clk}] -multiply_by {2} -divide_by {1}</data>
        </row>
        <row>
            <data>create_generated_clock -name {clk_150m} -source [get_ports {free_clk}] [get_nets {ov5640_clk.clkout1}] -master_clock [get_clocks {free_clk}] -multiply_by {6} -divide_by {1}</data>
        </row>
        <row>
            <data>create_generated_clock -name {clk_10m} -source [get_ports {free_clk}] [get_nets {ov5640_clk.clkout2}] -master_clock [get_clocks {free_clk}] -multiply_by {2} -divide_by {5}</data>
        </row>
        <row>
            <data>create_clock -name {cmos1_pclk} [get_ports {cmos1_pclk}] -period {13.158} -waveform {0.000 6.579}</data>
        </row>
        <row>
            <data>create_generated_clock -name {rst_clk} -source [get_ports {free_clk}] [get_pins {ddr3.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {free_clk}] -multiply_by {84} -divide_by {84}</data>
        </row>
        <row>
            <data>create_generated_clock -name {ddrphy_sysclk} -source [get_ports {free_clk}] [get_pins {ddr3.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {free_clk}] -multiply_by {84} -divide_by {16}</data>
        </row>
        <row>
            <data>create_generated_clock -name {phy_dq_clk_0} -source [get_ports {free_clk}] [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {free_clk}] -multiply_by {84} -divide_by {2}</data>
        </row>
        <row>
            <data>create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}</data>
        </row>
        <row>
            <data>create_generated_clock -name {phy_dq_clk_1} -source [get_ports {free_clk}] [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {free_clk}] -multiply_by {84} -divide_by {2}</data>
        </row>
        <row>
            <data>create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}</data>
        </row>
        <row>
            <data>create_clock -name {pclk} [get_pins {pcie_fifo.pango_pcie_top.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY.x2.GTP_HSST_2LANE_TOP.U_GTP_HSSTLP_WRAPPER.CHANNEL1_ENABLE.U_GTP_HSSTLP_LANE1.P_TCLK2FABRIC}] -period {4.000} -waveform {0.000 2.000}</data>
        </row>
        <row>
            <data>create_clock -name {pclk_div2} [get_pins {pcie_fifo.pango_pcie_top.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY.x2.GTP_HSST_2LANE_TOP.U_GTP_HSSTLP_WRAPPER.CHANNEL0_ENABLE.U_GTP_HSSTLP_LANE0.P_TCLK2FABRIC}] -period {8.000} -waveform {0.000 4.000}</data>
        </row>
        <row>
            <data>create_clock -name {ref_clk} [get_pins {pcie_fifo.pango_pcie_top.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY.x2.GTP_HSST_2LANE_TOP.U_GTP_HSSTLP_WRAPPER.PLL0_ENABLE.U_GTP_HSSTLP_PLL0.P_REFCK2CORE}] -period {10.000} -waveform {0.000 5.000}</data>
        </row>
        <row>
            <data>set_clock_groups -name clk_50m -asynchronous -group [get_clocks {clk_50m}]</data>
        </row>
        <row>
            <data>set_clock_groups -name clk_150m -asynchronous -group [get_clocks {clk_150m}]</data>
        </row>
        <row>
            <data>set_clock_groups -name clk_10m -asynchronous -group [get_clocks {clk_10m}]</data>
        </row>
        <row>
            <data>set_clock_groups -name cmos1_pclk -asynchronous -group [get_clocks cmos1_pclk]</data>
        </row>
        <row>
            <data>set_clock_groups -name free_clk -asynchronous -group [get_clocks {free_clk}]</data>
        </row>
        <row>
            <data>set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]</data>
        </row>
        <row>
            <data>set_clock_groups -name phy_dq_sysclk_0 -asynchronous -group [get_clocks {phy_dq_sysclk_0}]</data>
        </row>
        <row>
            <data>set_clock_groups -name phy_dq_sysclk_1 -asynchronous -group [get_clocks {phy_dq_sysclk_1}]</data>
        </row>
        <row>
            <data>set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]</data>
        </row>
        <row>
            <data>set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]</data>
        </row>
        <row>
            <data>set_clock_groups -name ddrphy_sysclk -asynchronous -group [get_clocks {ddrphy_sysclk}]</data>
        </row>
        <row>
            <data>set_clock_groups -name pclk -asynchronous -group [get_clocks {pclk}]</data>
        </row>
        <row>
            <data>set_clock_groups -name pclk_div2 -asynchronous -group [get_clocks {pclk_div2}]</data>
        </row>
        <row>
            <data>set_clock_groups -name ref_clk -asynchronous -group [get_clocks {ref_clk}]</data>
        </row>
        <row>
            <data>set_clock_uncertainty {0.002} [get_clocks {cmos1_pclk}]  -setup -hold</data>
        </row>
        <row>
            <data>set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold</data>
        </row>
        <row>
            <data>set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold</data>
        </row>
        <row>
            <data>set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold</data>
        </row>
        <row>
            <data>set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold</data>
        </row>
        <row>
            <data>set_multicycle_path 2 -setup -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]</data>
        </row>
        <row>
            <data>set_multicycle_path 1 -hold -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]</data>
        </row>
        <row>
            <data>set_multicycle_path 2 -setup -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]</data>
        </row>
        <row>
            <data>set_multicycle_path 1 -hold -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]</data>
        </row>
        <row>
            <data>set_false_path -through [get_pins -hier *ov5640_cdc*]</data>
        </row>
    </table>
