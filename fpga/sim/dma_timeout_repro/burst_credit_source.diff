+            2'b01: stored_words <= stored_words - CREDIT_WORDS_PER_BEAT;
+            2'b11: stored_words <= stored_words - (CREDIT_WORDS_PER_BEAT-1);
+            default: stored_words <= stored_words;
+        endcase
+    end
