--- a/source/sfp/rx_symbol_candidate.sv
+++ b/source/sfp/rx_symbol_candidate.sv
@@ -0,0 +1,89 @@
+// Isolated candidate: raw byte/K input, BC/28 controls and prefix-pair deletion.
+// Not a general GE PCS decoder. Unknown K/fragments set sticky malformed.
+module rx_symbol_candidate #(parameter FIFO_AW=11)(
+ input i_clk,i_rst_n,i_en,input [31:0] i_rxd,input [3:0] i_rxk,
+ output reg o_vs,o_hs,o_de,output reg [15:0] o_pix,output o_overflow,output o_malformed);
+ reg [95:0] buf_d,next_d; reg [11:0] buf_k,next_k;
+ integer count,next_count,cursor,available,events,step;
+ reg shadow_vs,shadow_hs,next_vs,next_hs,bad,next_bad,acquired,next_acquired;
+ assign o_malformed=bad;
+ reg [18:0] event0,event1,ev; reg valid_ev;
+ reg [18:0] mem0[0:(1<<(FIFO_AW-1))-1],mem1[0:(1<<(FIFO_AW-1))-1];
+ reg [FIFO_AW:0] wp,rp;
+ reg ovf; assign o_overflow=ovf;
+ wire [FIFO_AW:0] used=wp-rp;
+ wire accept=i_en && used<=((1<<FIFO_AW)-3);
+ wire [FIFO_AW-1:0] wa=wp[FIFO_AW-1:0],wb=wa+1'b1;
+ wire we0=accept && (events==2 || (events==1 && !wp[0]));
+ wire we1=accept && (events==2 || (events==1 && wp[0]));
+ wire [FIFO_AW-2:0] addr0=wp[0]?wb[FIFO_AW-1:1]:wa[FIFO_AW-1:1];
+ wire [FIFO_AW-2:0] addr1=wa[FIFO_AW-1:1];
+ wire [18:0] data0=wp[0]?event1:event0,data1=wp[0]?event0:event1;
+ wire [18:0] rsym=rp[0]?mem1[rp[FIFO_AW-1:1]]:mem0[rp[FIFO_AW-1:1]];
+ // Up to two ordered events per cycle; unchanged controls consume no FIFO.
+ always @* begin
+  next_d=buf_d;next_k=buf_k;
+  next_d[count*8 +:32]=i_rxd;next_k[count +:4]=i_rxk;
+  available=count+4;cursor=0;events=0;event0=0;event1=0;
+  next_vs=shadow_vs;next_hs=shadow_hs;next_bad=bad;ev=0;valid_ev=0;next_acquired=acquired;
+  for(step=0;step<4;step=step+1) begin
+   if(cursor<4 && available-cursor>=4 && events<2) begin
+    ev=0;valid_ev=1;
+    if(next_k[cursor +:4]==4'b1001 &&
+       next_d[cursor*8 +:8]==8'hbc && next_d[(cursor+1)*8 +:8]==8'h28 &&
+       next_d[(cursor+3)*8 +:8]==8'hbc &&
+       (next_d[(cursor+2)*8 +:8]&8'h9f)==0) begin
+     ev={1'b1,next_d[(cursor+2)*8+5],next_d[(cursor+2)*8+6],16'b0};cursor=cursor+4;next_acquired=1;
+    end else if(!next_acquired) begin
+     cursor=cursor+1;valid_ev=0;
+    end else if(next_k[cursor +:3]==3'b101 &&
+       next_d[cursor*8 +:8]==8'hbc && next_d[(cursor+1)*8 +:8]==8'h28 &&
+       next_d[(cursor+2)*8 +:8]==8'hbc) begin
+     // Inserted BC/28 pair before another K-started control.
+     cursor=cursor+2;valid_ev=0;
+    end else if(next_k[cursor +:2]==2'b10 &&
+       next_d[(cursor+1)*8 +:8]==8'hbc && (next_d[cursor*8 +:8]&8'h9f)==0) begin
+     // Only the status/end-K suffix remains after BC(K),28(D) removal.
+     ev={1'b1,next_d[cursor*8+5],next_d[cursor*8+6],16'b0};cursor=cursor+2;
+    end else if(next_k[cursor +:2]==0) begin
+     ev={3'b000,next_d[cursor*8 +:16]};cursor=cursor+2;
+    end else begin
+     next_bad=1;next_acquired=0;cursor=cursor+1;valid_ev=0;
+    end
+    if(valid_ev && next_acquired && !ev[18]) begin
+     if(events==0)event0=ev;else event1=ev;events=events+1;
+    end
+    if(valid_ev && next_acquired && ev[18]) begin
+     if(ev[17]!=next_vs || ev[16]!=next_hs) begin
+      if(events==0)event0=ev;else event1=ev;events=events+1;
+      next_vs=ev[17];next_hs=ev[16];
+     end
+    end
+   end
+  end
+  next_d=next_d>>(cursor*8);next_k=next_k>>cursor;next_count=available-cursor;
+ end
+ always @(posedge i_clk) begin
+  if(we0)mem0[addr0]<=data0;
+  if(we1)mem1[addr1]<=data1;
+ end
+ always @(posedge i_clk or negedge i_rst_n) begin
+  if(!i_rst_n) begin
+   buf_d<=0;buf_k<=0;count<=0;shadow_vs<=0;shadow_hs<=0;bad<=0;acquired<=0;wp<=0;rp<=0;
+   o_vs<=0;o_hs<=0;o_de<=0;o_pix<=0;ovf<=0;
+  end else if(!i_en) begin
+   buf_d<=0;buf_k<=0;count<=0;shadow_vs<=0;shadow_hs<=0;bad<=0;acquired<=0;wp<=0;rp<=0;
+   o_vs<=0;o_hs<=0;o_de<=0;ovf<=0;
+  end else begin
+   buf_d<=next_d;buf_k<=next_k;count<=next_count;bad<=next_bad;acquired<=next_acquired;
+   ovf<=events>0 && !accept;
+   if(accept) begin wp<=wp+events;shadow_vs<=next_vs;shadow_hs<=next_hs;end
+   o_de<=0;
+   if(wp!=rp) begin
+    rp<=rp+1'b1;
+    if(rsym[18])begin o_vs<=rsym[17];o_hs<=rsym[16];end
+    else begin o_de<=1;o_pix<=rsym[15:0];end
+   end
+  end
+ end
+endmodule
--- a/source/sfp/sfp_rx_diagnostics.sv
+++ b/source/sfp/sfp_rx_diagnostics.sv
@@ -0,0 +1,70 @@
+// RX-domain counters with a bundled-data request/ack snapshot to host clock.
+module sfp_rx_diagnostics #(parameter NEW_PARSER=0)(
+ input rx_clk,rx_rst_n,host_clk,host_rst_n,link_en,
+ input [31:0] raw_d,input [3:0] raw_k,disp_err,decode_err,
+ input [2:0] status,input [1:0] phase,input vs,de,malformed,overflow,
+ output reg [511:0] host_snapshot);
+ reg [31:0] c[0:15]; integer i;
+ reg prev_vs,prev_link;reg [1:0] prev_phase;reg [31:0] frame_dec,frame_raw;
+ reg [31:0] frame_disp,frame_decode;
+ reg req,ack;reg [1:0] req_sync,ack_sync;reg [511:0] held;
+ reg [511:0] data_sync0,data_sync1;
+ reg [31:0] host_seq;
+ reg [7:0] prev_byte;reg prev_k,prev_raw_valid;
+ wire [2:0] matches50=
+  ((prev_raw_valid && prev_k && prev_byte==8'hbc && !raw_k[0] && raw_d[7:0]==8'h50)?3'd1:3'd0)+
+  ((raw_k[1:0]==1 && raw_d[7:0]==8'hbc && raw_d[15:8]==8'h50)?3'd1:3'd0)+
+  ((raw_k[2:1]==1 && raw_d[15:8]==8'hbc && raw_d[23:16]==8'h50)?3'd1:3'd0)+
+  ((raw_k[3:2]==1 && raw_d[23:16]==8'hbc && raw_d[31:24]==8'h50)?3'd1:3'd0);
+ wire [2:0] matches28=
+  ((prev_raw_valid && prev_k && prev_byte==8'hbc && !raw_k[0] && raw_d[7:0]==8'h28)?3'd1:3'd0)+
+  ((raw_k[1:0]==1 && raw_d[7:0]==8'hbc && raw_d[15:8]==8'h28)?3'd1:3'd0)+
+  ((raw_k[2:1]==1 && raw_d[15:8]==8'hbc && raw_d[23:16]==8'h28)?3'd1:3'd0)+
+  ((raw_k[3:2]==1 && raw_d[23:16]==8'hbc && raw_d[31:24]==8'h28)?3'd1:3'd0);
+ wire sof=vs && !prev_vs;
+ always @(posedge rx_clk or negedge rx_rst_n) begin
+  if(!rx_rst_n)begin
+   for(i=0;i<16;i=i+1)c[i]<=0;
+   prev_vs<=0;prev_link<=0;prev_phase<=0;frame_dec<=0;frame_raw<=0;frame_disp<=0;frame_decode<=0;
+   req_sync<=0;ack<=0;held<=0;prev_byte<=0;prev_k<=0;prev_raw_valid<=0;
+  end else begin
+   req_sync<={req_sync[0],req};
+   prev_vs<=vs;prev_link<=link_en;prev_phase<=phase;
+   prev_byte<=raw_d[31:24];prev_k<=raw_k[3];prev_raw_valid<=link_en;
+   c[0]<=32'h52580000 | (NEW_PARSER<<8) | (malformed<<1) | link_en;
+   if(link_en)begin
+    if(status==2)c[1]<=c[1]+1;
+    if(status==1)c[2]<=c[2]+1;
+    if(raw_k==2)c[3]<=c[3]+1;
+    if(raw_k==4)c[4]<=c[4]+1;
+    if(phase!=prev_phase)c[5]<=c[5]+1;
+    if(|disp_err)frame_disp<=frame_disp+1;
+    if(|decode_err)frame_decode<=frame_decode+1;
+    c[10]<=c[10]+matches50;c[11]<=c[11]+matches28;
+    frame_raw<=frame_raw+(raw_k==0?2:0);
+    if(status>=4)c[12]<=c[12]+1;
+   end
+   if(de)begin frame_dec<=frame_dec+1;end
+   if(overflow)c[13]<=c[13]+1;
+   if(prev_link && !link_en)c[14]<=c[14]+1;
+   if(sof)begin
+    c[8]<=frame_dec;c[9]<=frame_raw;c[15]<=c[15]+1;c[6]<=frame_disp;c[7]<=frame_decode;
+    frame_disp<=link_en && |disp_err?1:0;frame_decode<=link_en && |decode_err?1:0;
+    frame_dec<=de?1:0;frame_raw<=link_en && raw_k==0?2:0;
+   end
+   if(req_sync[1]!=ack)begin
+    for(i=0;i<16;i=i+1)held[i*32 +:32]<=c[i];
+    ack<=req_sync[1];
+   end
+  end
+ end
+ // The source holds data until the next request. Two data stages and an
+ // additional equality cycle precede consumption; host then requests again.
+ always @(posedge host_clk or negedge host_rst_n) begin
+  if(!host_rst_n)begin req<=1;ack_sync<=0;data_sync0<=0;data_sync1<=0;host_snapshot<=0;host_seq<=0;end
+  else begin
+   ack_sync<={ack_sync[0],ack};data_sync0<=held;data_sync1<=data_sync0;
+   if(ack_sync[1]==req)begin host_snapshot<=data_sync1;host_seq<=host_seq+1;req<=~req;end
+  end
+ end
+endmodule
