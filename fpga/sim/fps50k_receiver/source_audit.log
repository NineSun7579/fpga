41: always @(*) begin
42:     case (curr_state)
43:         IDLE: begin
44:                 if(s_vsync_rise & axi_cam_en && !engine_busy && !capture_stop) begin  // [IDLEGATE 2026-09-19] admit a frame only when the engine finished the previous one
45:                 next_state = DATA;
46:             end
47:             else begin
48:                 next_state = IDLE;
49:             end
50:         end 
51:         DATA: begin
52:             if(s_vsync_rise) begin
53:                     if(axi_cam_en && !engine_busy && !capture_stop) begin  // [IDLEGATE] engine wedged mid-frame: drop the rest at this vsync
54:                     next_state = DATA;
55:                 end
56:                 else begin
57:                     next_state = IDLE;
58:                 end
59:             end
88: assign m_hsync = s_hsync;
89: assign m_data       = s_data;
90: assign m_data_valid = s_data_valid & (curr_state == DATA) && !capture_stop && !s_vsync;
91: 
92: // A completed frame owns its DDR buffer until the host acknowledges it.
93: // Drop whole sensor frames at VSYNC boundaries while one frame is pending.
94:     assign m_vsync = s_vsync_rise & axi_cam_en && !engine_busy && !capture_stop;  // [IDLEGATE 2026-09-19]
source/ov5640/ov5640_ddr/ov5640_ddr_w_ctrl.v
45:     localparam IDLE      = 3'b001;
46:     localparam ADDR      = 3'b010;
47:     localparam DATA      = 3'b100;
48:     // [FRTAG 2026-09-14] tag states: second (16B) command after the frame completes
49:     localparam ADDR_TAG  = 3'b011;
50:     localparam DATA_TAG  = 3'b101;
51:     localparam WAIT_TAG_DONE = 3'b110;
52: 
53:     reg [2 : 0] curr_state/*synthesis PAP_MARK_DEBUG="1"*/;
54:     // [LEDGER 2026-09-19] both the frame command and the 16B tag command pulse
55:     // dma_done; only the frame command's completion may advance frame state.
56:     wire frame_done = dma_done && frame_good && (curr_state == DATA);
57:     wire frame_failed = (dma_abort || (dma_done && !frame_good)) && (curr_state == DATA);
58:     wire publish = dma_done && (curr_state == WAIT_TAG_DONE);
104:             DATA: begin
105:                 if(frame_failed) next_state = IDLE;
106:                 else if(frame_done)begin
107:                     next_state = ADDR_TAG;              // [FRTAG] frame complete, go write the tag
108:                 end
109:                 else begin
110:                     next_state = DATA;
111:                 end
112:             end
113:             ADDR_TAG: begin
114:                 if(axi_cmd_ready & axi_cmd_valid)begin
115:                     next_state = DATA_TAG;
116:                 end
117:                 else begin
118:                     next_state = ADDR_TAG;
119:                 end
120:             end
121:             DATA_TAG: begin
122:                 if(dma_abort) next_state = IDLE;
123:                 else if(tag_fire)begin
124:                     next_state = WAIT_TAG_DONE;
125:                 end
126:                 else begin
127:                     next_state = DATA_TAG;
128:                 end
129:             end
130:             WAIT_TAG_DONE: begin
131:                 if(dma_done || dma_abort) next_state = IDLE;
132:                 else         next_state = WAIT_TAG_DONE;
172:     // Only latch admitted SOF while idle. Busy-frame markers are discarded;
173:     // replaying one after retirement would restart in the middle of a frame.
174:     always @(posedge axi_clk) begin
175:         if(axi_rst)begin
176:             vsync_pending <= 1'b0;
177:         end
178:         else if(axi_vsync_rise && (curr_state == IDLE))begin
179:             vsync_pending <= 1'b1;
180:         end
181:         else if((curr_state == IDLE) && vsync_pending)begin
182:             vsync_pending <= 1'b0;
183:         end
184:     end
237:     always @(posedge axi_clk) begin
238:         if(axi_rst)begin
239:             frame_cnt <= 32'd0;
240:         end
241:         else if(publish)begin
242:             frame_cnt <= frame_cnt + 32'd1;
243:         end
244:     end
245: 
246:     assign frame_active = (curr_state == DATA);
247:     assign tag_active  = (curr_state == DATA_TAG);
248:     assign tag_data    = {{(AXI_DATA_WIDTH-32){1'b0}}, (frame_cnt + 32'd1)};
249:     assign tag_fire    = tag_active & tag_ready;
source/ov5640/ov5640_ddr/ov5640_ddr.v
70: // Capture validity belongs to the admitted SOF, never to a DMA timeout.
71: // Flush only on DMA retirement (all external W/B obligations are finished).
72: reg [2:0] flush_count;
73: wire capture_flush = (flush_count != 0);
74: reg capture_open, capture_bad;
75: reg [31:0] pixel_count, pixel_limit;
76: reg raw_vsync_q;
77: wire raw_sof = s_vsync && !raw_vsync_q;
78: wire capture_overflow;
79: wire capture_complete = capture_open && (pixel_count == pixel_limit);
80: wire frame_good = capture_complete && !capture_bad && !capture_overflow;
81: wire capture_stop = capture_flush || capture_bad || capture_complete;
82: assign dma_abort_req = capture_bad;
115: always @(posedge axi_clk) begin
116:     if(axi_rst) begin
117:         flush_count <= 4;
118:         raw_vsync_q <= 0;
119:     end else begin
120:         raw_vsync_q <= s_vsync;
121:         if(dma_abort || (dma_done && (!frame_active || !frame_good))) flush_count <= 4;
122:         else if(capture_flush) flush_count <= flush_count - 1'b1;
123:     end
124: end
125: always @(posedge axi_clk) begin
126:     if(axi_rst || capture_flush) begin
127:         capture_open <= 0;
128:         capture_bad <= 0;
129:         pixel_count <= 0;
130:         pixel_limit <= 0;
131:     end else if(m_vsync) begin
132:         capture_open <= 1;
133:         capture_bad <= (cam_data_len == 0);
134:         pixel_count <= 0;
135:         pixel_limit <= (cam_data_len * AXI_DATA_WIDTH) / DATA_WIDTH;
136:     end else if(capture_open) begin
137:         if(m_data_valid) pixel_count <= pixel_count + 1'b1;
138:         if(capture_overflow || (raw_sof && !capture_complete)) capture_bad <= 1;
139:     end
