41:     reg  [10:0] x_cnt;
42:     reg         vs_q;
43:     wire        vs_rise = i_vs & ~vs_q;
44:     always @(posedge i_rx_clk or negedge i_rx_rst_n) begin
45:         if (!i_rx_rst_n) begin
46:             x_cnt <= 11'd0;
47:             vs_q  <= 1'b0;
48:         end
49:         else begin
50:             vs_q <= i_vs;
51:             if (vs_rise)
52:                 x_cnt <= 11'd0;
53:             else if (i_de)
54:                 x_cnt <= (x_cnt == IMG_W-1) ? 11'd0 : x_cnt + 11'd1;
55:         end
56:     end
57: 
58:     wire sel5 = (x_cnt < SPLIT_W);
59: 
60:     wire [18:0] sym5_w = {i_vs, i_hs, i_de &  sel5, i_pix};
61:     wire [18:0] sym6_w = {i_vs, i_hs, i_de & ~sel5, i_pix};
71:     video_async_fifo #(.WIDTH(19), .DEPTH(FIFO_D)) u_fifo5 (
