85:         .wr_clk   (i_rx_clk),
86:         .wr_rst_n (i_rx_rst_n),
87:         .wr_en    (1'b1),
88:         .wr_data  (sym6_w),
89:         .full     (fif6_full),
90:         .rd_clk   (i_axi_clk),
91:         .rd_rst_n (i_axi_rst_n),
92:         .rd_en    (~fif6_empty),
93:         .rd_data  (fif6_rdata),
94:         .empty    (fif6_empty)
95:     );
122:     assign o_vs5  = fif5_empty ? vs5_hold : fif5_rdata[18];
