(_flow fab_demo "PDS_2022.2"
    (_comment "Compiler (version on 2022.2<build 117044>) at Fri Sep 25 20:43:18 +0800 2026")
    (_version "1.0.9")
    (_status "initial")
    (_project
        (_option prj_work_dir (_string ""))
        (_option prj_impl_dir (_string ""))
    )
    (_task tsk_setup
        (_widget wgt_select_arch
            (_input
                (_part
                    (_family Logos2)
                    (_device PG2L100H)
                    (_speedgrade -6)
                    (_package FBG484)
                )
            )
        )
        (_command cmd_load_arch
        (_gci_state (_integer 0))
        )
        (_widget wgt_my_design_src
            (_input
                (_file "../../example_design/rtl/ipsxe_fir_onboard_top.v" + "ipsxe_fir_onboard_top"
                    (_format verilog)
                    (_timespec "")
                )
                (_file "../../example_design/rtl/ipsxe_fir_frame_gen.v"
                    (_format verilog)
                    (_timespec "")
                )
                (_file "../../example_design/rtl/ipsxe_fir_frame_chk.v"
                    (_format verilog)
                    (_timespec "")
                )
                (_file "../../example_design/rtl/ipsxe_fir_cross_sync.v"
                    (_format verilog)
                    (_timespec "")
                )
            )
        )
        (_widget wgt_my_ips_src
            (_input
                (_ip "../../FIR.idf"
                    (_timespec "")
                    (_ip_source_item "../../FIR.v"
                        (_timespec "")
                    )
                    (_ip_source_item "../../rtl/ipsxe_fir_core_v1_2_FIR.v"
                        (_timespec "")
                    )
                    (_ip_source_item "../../rtl/synplify/ipsxe_fir_core_v1_2_vpAll.vp"
                        (_timespec "")
                    )
                    (_ip_source_item "../../rtl/ipsxe_fir_data_pipeline/ipsxe_fir_distributed_shiftregister.v"
                        (_timespec "")
                    )
                    (_ip_source_item "../../rtl/ipsxe_fir_data_pipeline/ipsxe_fir_distributed_sdpram.v"
                        (_timespec "")
                    )
                    (_ip_source_item "../../rtl/ipsxe_fir_data_pipeline/ipsxe_fir_data_pipeline.v"
                        (_timespec "")
                    )
                )
            )
        )
        (_widget wgt_import_logic_con_file
            (_input
                (_file "ipsxe_fir_onboard_top.fdc"
                    (_format fdc)
                    (_timespec "2019-06-03T09:18:43")
                )
            )
        )
        (_widget wgt_edit_user_cons
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_synthesis
        (_command cmd_synthesize
        (_gci_state (_integer 0))
            (_option ads (_switch ON))
            (_option selected_syn_tool_opt (_integer 2))
        )
    )
    (_task tsk_devmap
        (_command cmd_devmap
        (_gci_state (_integer 0))
        )
        (_widget wgt_edit_placement_cons
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_pnr
        (_command cmd_pnr
        (_gci_state (_integer 0))
        (_option optimize_multi_corner_timing (_switch ON))
        (_option fix_hold_violation (_switch ON))
        )
        (_command cmd_report_post_pnr_timing
        (_gci_state (_integer 0))
            (_attribute _auto_exe_lock (_switch OFF))
            (_option configuration (_switch ON))
        )
        (_widget wgt_arch_browser
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_gen_bitstream
        (_command cmd_gen_bitstream
        (_gci_state (_integer 0))
        )
    )
)
