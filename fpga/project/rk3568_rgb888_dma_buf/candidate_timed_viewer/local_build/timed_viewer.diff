 private:
+    // Per-call offsets share one steady clock. OFF performs no telemetry clock
+    // reads or logging. Hold wall includes command transport and release ack;
+    // it is not a measurement of the FPGA's internal hold duration.
+    struct FpgaReadTiming {
+        static bool enabled() {
+            static const bool value = qgetenv("DETVIEW_FPGA_INFER_TIMING") == "1" &&
+                                      QElapsedTimer::isMonotonic();
+            return value;
+        }
+        const bool active = enabled();
+        QElapsedTimer clock;
+        qint64 acquisition = 0, holdCommandIssue = 0, holdValidated = 0,
+               rawF2hTag = 0, converterStart = 0, converterDone = 0,
+               releaseVerified = 0, rawCpuCopy = 0, publishReady = 0;
+        void start() { if (active) clock.start(); }
+        void mark(qint64& phase) { if (active) phase = clock.nsecsElapsed(); }
+        void report(int camera, int generation, int height, uint32_t tag) {
+            if (!active) return;
+            const qint64 totalRead = clock.nsecsElapsed();
+            // The transport lock was released before RAW CPU copy and logging.
+            qInfo("[fpga-infer-timing] camera=%d generation=%d height=%d tag=%u clock=QElapsedTimer_monotonic phase_unit=ns phase_origin=read_entry acquisition_ns=%lld hold_command_issue_ns=%lld hold_validated_ns=%lld raw_f2h_tag_ns=%lld converter_start_ns=%lld converter_done_ns=%lld release_verified_ns=%lld raw_cpu_copy_ns=%lld publish_ready_ns=%lld hold_command_to_release_ack_wall_ns=%lld total_read_ns=%lld",
+                  camera + 1, generation, height, tag,
+                  static_cast<long long>(acquisition), static_cast<long long>(holdCommandIssue),
+                  static_cast<long long>(holdValidated), static_cast<long long>(rawF2hTag),
+                  static_cast<long long>(converterStart), static_cast<long long>(converterDone),
+                  static_cast<long long>(releaseVerified), static_cast<long long>(rawCpuCopy),
+                  static_cast<long long>(publishReady),
+                  static_cast<long long>(releaseVerified - holdCommandIssue),
+                  static_cast<long long>(totalRead));
+        }
+    };
