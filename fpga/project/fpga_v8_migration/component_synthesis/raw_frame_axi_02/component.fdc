# Component-only 150 MHz nominal target, not routed board timing acceptance.
create_clock -name {component_clk} [get_ports {clk}] -period {6.666667} -waveform {0.000000 3.333333}
# Internal AXI component ports; no physical pins or IO electrical attributes.
define_attribute {p:*} {PAP_IS_VIRTUAL_IO} {TRUE}
