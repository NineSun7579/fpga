(_flow raw_frame_axi_component "2022.2-SP6.4"
    (_comment "Isolated RAW frame AXI component: compile and synthesis only")
    (_version "1.1.0")
    (_status "initial")
    (_project
        (_option prj_work_dir (_string "."))
        (_option prj_impl_dir (_string "."))
    )
    (_task tsk_setup
        (_widget wgt_select_arch
            (_input
                (_part
                    (_family Logos2)
                    (_device PG2L100H)
                    (_speedgrade -6)
                    (_package FBG484)
                )
            )
        )
        (_widget wgt_my_design_src
            (_input
                (_file "../../raw_preprocess/fpga_v8_raw_letterbox.v"
                    (_format verilog)
                )
                (_file "../../raw_preprocess/fpga_v8_rgb888_pack128.v"
                    (_format verilog)
                )
                (_file "../../cooperative_axi/fpga_v8_raw_frame_axi.v"
                    (_format verilog)
                )
            )
        )
        (_widget wgt_import_logic_con_file
            (_input
                (_file "component.fdc"
                    (_format fdc)
                )
            )
        )
    )
    (_task tsk_compile
        (_command cmd_compile)
    )
    (_task tsk_synthesis
        (_command cmd_synthesize
            (_option selected_syn_tool_opt (_integer 2))
        )
    )
)
