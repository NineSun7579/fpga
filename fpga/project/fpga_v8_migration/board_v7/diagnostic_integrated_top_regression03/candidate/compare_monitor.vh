integer trace_fd, host_samples=0, cam_samples=0, reset_samples=0;
reg [8191:0] trace_last; reg trace_started=0;
initial begin trace_fd=$fopen("comparison.trace","w"); if(!trace_fd) $fatal(1,"trace open"); end
task trace_sample(input integer kind);
 reg [8191:0] value;
 begin
 value={u_awready,u_wready,u_bvalid,u_bresp,u_arready,u_rvalid,u_rresp,dma_rdata,dut.axi_rst,dut.camera_ctrl_rst_n,dut.source_diagnostics.cam_reset,dut.source_diagnostics.invalid,dut.source_diagnostics.valid,dut.source_diagnostics.available,dut.source_diagnostics.overrun,dut.source_diagnostics.rv,dut.source_diagnostics.re,dut.source_diagnostics.m_awvalid,dut.source_diagnostics.m_awaddr,dut.source_diagnostics.m_wvalid,dut.source_diagnostics.m_wdata,dut.source_diagnostics.m_wstrb,dut.source_diagnostics.m_bready,dut.source_diagnostics.m_arvalid,dut.source_diagnostics.m_araddr,dut.source_diagnostics.m_rready,dut.source_diagnostics.epoch[0],dut.source_diagnostics.cameras[0].reset_pipe,dut.source_diagnostics.cameras[0].source.cr,dut.source_diagnostics.cameras[0].source.hr,dut.source_diagnostics.cameras[0].source.ack_sync,dut.source_diagnostics.cameras[0].source.req_sync,dut.source_diagnostics.cameras[0].source.overrun_sync,dut.source_diagnostics.cameras[0].source.request,dut.source_diagnostics.cameras[0].source.ack,dut.source_diagnostics.cameras[0].source.mailbox,dut.source_diagnostics.cameras[0].source.host_bank,dut.source_diagnostics.cameras[0].source.read_data,dut.source_diagnostics.cameras[0].source.read_valid,dut.source_diagnostics.cameras[0].source.read_error,dut.source_diagnostics.cameras[0].source.snapshot_valid,dut.source_diagnostics.cameras[0].source.seq_q,dut.source_diagnostics.epoch[1],dut.source_diagnostics.cameras[1].reset_pipe,dut.source_diagnostics.cameras[1].source.cr,dut.source_diagnostics.cameras[1].source.hr,dut.source_diagnostics.cameras[1].source.ack_sync,dut.source_diagnostics.cameras[1].source.req_sync,dut.source_diagnostics.cameras[1].source.overrun_sync,dut.source_diagnostics.cameras[1].source.request,dut.source_diagnostics.cameras[1].source.ack,dut.source_diagnostics.cameras[1].source.mailbox,dut.source_diagnostics.cameras[1].source.host_bank,dut.source_diagnostics.cameras[1].source.read_data,dut.source_diagnostics.cameras[1].source.read_valid,dut.source_diagnostics.cameras[1].source.read_error,dut.source_diagnostics.cameras[1].source.snapshot_valid,dut.source_diagnostics.cameras[1].source.seq_q,dut.source_diagnostics.epoch[2],dut.source_diagnostics.cameras[2].reset_pipe,dut.source_diagnostics.cameras[2].source.cr,dut.source_diagnostics.cameras[2].source.hr,dut.source_diagnostics.cameras[2].source.ack_sync,dut.source_diagnostics.cameras[2].source.req_sync,dut.source_diagnostics.cameras[2].source.overrun_sync,dut.source_diagnostics.cameras[2].source.request,dut.source_diagnostics.cameras[2].source.ack,dut.source_diagnostics.cameras[2].source.mailbox,dut.source_diagnostics.cameras[2].source.host_bank,dut.source_diagnostics.cameras[2].source.read_data,dut.source_diagnostics.cameras[2].source.read_valid,dut.source_diagnostics.cameras[2].source.read_error,dut.source_diagnostics.cameras[2].source.snapshot_valid,dut.source_diagnostics.cameras[2].source.seq_q,dut.source_diagnostics.epoch[3],dut.source_diagnostics.cameras[3].reset_pipe,dut.source_diagnostics.cameras[3].source.cr,dut.source_diagnostics.cameras[3].source.hr,dut.source_diagnostics.cameras[3].source.ack_sync,dut.source_diagnostics.cameras[3].source.req_sync,dut.source_diagnostics.cameras[3].source.overrun_sync,dut.source_diagnostics.cameras[3].source.request,dut.source_diagnostics.cameras[3].source.ack,dut.source_diagnostics.cameras[3].source.mailbox,dut.source_diagnostics.cameras[3].source.host_bank,dut.source_diagnostics.cameras[3].source.read_data,dut.source_diagnostics.cameras[3].source.read_valid,dut.source_diagnostics.cameras[3].source.read_error,dut.source_diagnostics.cameras[3].source.snapshot_valid,dut.source_diagnostics.cameras[3].source.seq_q};
 if(!trace_started || value !== trace_last) $fdisplay(trace_fd,"%0t %0d %h",$time,kind,value);
 trace_started=1;trace_last=value;
 end
endtask
always @(posedge clk) begin #0.002; if($time>=20) begin host_samples++;trace_sample(0);end end
always @(posedge camclk) begin #0.003; if($time>=20) begin cam_samples++;trace_sample(1);end end
always @(dut.source_diagnostics.cam_reset or dut.axi_rst) begin
 #0.004; if($time>=20) begin reset_samples++;trace_sample(2);end
end
final begin
 $fdisplay(trace_fd,"SAMPLES %0d %0d %0d",host_samples,cam_samples,reset_samples);
 $fclose(trace_fd);
 $display("TOP_COMPARE_SAMPLES host=%0d cam=%0d reset=%0d",host_samples,cam_samples,reset_samples);
end
