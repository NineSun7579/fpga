  "packing_rule": "rule gopL6Q\nbegin\n    # the suffix of the new instance name is \"_L6Q\"\n    gopQ inst1 + gopLUT6 inst2 => gopLUT6Q _L6Q\n    \n    # find other insts according to inst1 using net connections\n    seeking\n    begin\n        inst2 : D of inst1 and L6 of inst2 output\n    end\n    \n    conditions\n    begin\n        # compare with ToChar() function\n        # same_net :\n        # same_parameter :\n        # parameter :\n    end   \n    \n    constraints\n    begin\n        pair inst1 inst2\n        begin\n            # site_of_inst1 sym_of_inst1 site_of_inst2 sym_of_inst2\n            NIL NIL NIL NIL\n        end\n    end\n        \n    # default is copying    \n    parameters_mapping\n    begin\n        GRS_EN       of inst1  => GRS_EN\n        LRS_EN       of inst1  => LRS_EN\n        CEMUX_SEL    of inst1  => CEMUX_SEL  \n        RSMUX_SEL    of inst1  => RSMUX_SEL\n        QMUX_SEL     of inst1  => NIL  \n        CLK_POL   of inst1  => CLK_POL  \n        LCE_POL   of inst1  => LCE_POL   \n        LRS_POL   of inst1  => LRS_POL   \n        RS_MODE      of inst1  => RS_MODE\n        FF_RS        of inst1  => FF_RS\n        FF_INIT      of inst1  => FF_INIT\n        INIT         of inst2  => INIT\n        IMPL_MODE of inst1  => NIL\n    end \n       \n    ports_mapping\n    begin \n        D of inst1 => NIL\n        Q of inst1 => L6Q\n        L6 of inst2 => L6\n    end\nend\n\n",
