(_flow fab_demo "2022.2-SP6.4"
    (_version "1.1.0")
    (_status "initial")
    (_project
        (_option prj_work_dir (_string "."))
        (_option prj_impl_dir (_string "."))
    )
    (_task tsk_setup
        (_widget wgt_select_arch
            (_input (_part (_family Logos2) (_device PG2L100H) (_speedgrade -6) (_package FBG484)))
        )
        (_widget wgt_my_design_src
            (_input (_file "rtl/twoff_probe.v" (_format verilog)))
        )
        (_widget wgt_my_ips_src)
        (_widget wgt_import_logic_con_file
            (_input
                (_file "constraints/clock.fdc" (_format fdc))
                (_file "constraints/site.lcf" (_format lcf))
            )
        )
    )
    (_task tsk_compile
        (_command cmd_compile (_gci_state (_integer 0))
            (_option top_module (_string "map03_twoff_probe")))
    )
    (_task tsk_synthesis
        (_command cmd_synthesize (_gci_state (_integer 0))
            (_option selected_syn_tool_opt (_integer 2)))
    )
    (_task tsk_devmap
        (_command cmd_devmap (_gci_state (_integer 0)))
        (_widget wgt_edit_placement_cons
            (_input (_file "device_map/map03_twoff_probe.pcf" (_format pcf)))
        )
    )
    (_task tsk_pnr (_command cmd_pnr (_gci_state (_integer 0))))
    (_task tsk_gen_bitstream (_command cmd_gen_bitstream (_gci_state (_integer 0))))
)
