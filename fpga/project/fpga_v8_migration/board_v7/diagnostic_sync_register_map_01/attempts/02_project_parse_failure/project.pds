(_flow fab_demo "2022.2-SP6.4"
 (_comment "Isolated diagnostic mapping experiment")
 (_version "1.1.0")
 (_status "initial")
 (_project (_option prj_work_dir (_string ".")) (_option prj_impl_dir (_string ".")))
 (_task tsk_setup
 (_widget wgt_select_arch (_input (_part (_family Logos2) (_device PG2L100H) (_speedgrade -6) (_package FBG484))))
 (_widget wgt_my_design_src (_input
  (_file "rtl/v7_sdt_top.v" (_format verilog))
  (_file "rtl/v7_sdt_bus.v" (_format verilog))
  (_file "rtl/v7_sfd_candidate.v" (_format verilog))
))
 (_widget wgt_import_logic_con_file (_input (_file "constraints/clock.fdc" (_format fdc))))
 )
    (_task tsk_compile
        (_command cmd_compile
            (_gci_state (_integer 0))
            (_option top_module (_string "v7_sdt_top"))
            (_db_output
                (_file "compile/v7_sdt_top_comp.adf"
                    (_format adif)
                    (_timespec "2026-10-06T22:56:51")
                )
            )
            (_output
                (_file "compile/v7_sdt_top.cmr"
                    (_format verilog)
                    (_timespec "2026-10-06T22:56:51")
                )
                (_file "compile/cmr.db"
                    (_format text)
                    (_timespec "2026-10-06T22:56:51")
                )
            )
        )
        (_widget wgt_rtl_view
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_synthesis
        (_command cmd_synthesize
            (_gci_state (_integer 0))
            (_option selected_syn_tool_opt (_integer 2))
            (_db_output
                (_file "synthesize/v7_sdt_top_syn.adf"
                    (_format adif)
                    (_timespec "2026-10-06T23:12:06")
                )
            )
            (_output
                (_file "synthesize/v7_sdt_top_syn.vm"
                    (_format structural_verilog)
                    (_timespec "2026-10-06T23:12:13")
                )
                (_file "synthesize/v7_sdt_top_controlsets.txt"
                    (_format text)
                    (_timespec "2026-10-06T23:06:38")
                )
                (_file "synthesize/snr.db"
                    (_format text)
                    (_timespec "2026-10-06T23:12:30")
                )
                (_file "synthesize/v7_sdt_top.snr"
                    (_format text)
                    (_timespec "2026-10-06T23:12:30")
                )
            )
        )
        (_widget wgt_tech_view
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_map_constraint
        )
        (_widget wgt_my_fic_src
        )
        (_widget wgt_inserter_gui_view
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_devmap
        (_command cmd_devmap
            (_option devmap_remove_dups (_integer 0))
            (_option devmap_const_prop (_integer 0))
            (_option devmap_control_set_num (_integer 0))

            (_gci_state (_integer 0))
            (_db_output
                (_file "device_map/v7_sdt_top_map.adf"
                    (_format adif)
                    (_timespec "2026-10-06T23:14:14")
                )
            )
            (_output
                (_file "device_map/v7_sdt_top_dmr.prt"
                    (_format text)
                    (_timespec "2026-10-06T23:12:50")
                )
                (_file "device_map/v7_sdt_top.dmr"
                    (_format text)
                    (_timespec "2026-10-06T23:14:15")
                )
                (_file "device_map/dmr.db"
                    (_format text)
                    (_timespec "2026-10-06T23:14:15")
                )
            )
        )
        (_widget wgt_edit_placement_cons
            (_attribute _click_to_run (_switch ON))
            (_input
                (_file "device_map/v7_sdt_top.pcf"
                    (_format pcf)
                    (_timespec "2026-10-06T23:14:15")
                )
            )
        )
        (_widget wgt_edit_route_cons
            (_attribute _click_to_run (_switch ON))
        )
    )
)
