# Isolated roots replacing parent PLL outputs; no false-path/clock-group relaxation.
create_clock -name {ddrphy_sysclk} [get_ports {clk}] -period {7.619} -waveform {0 3.8095}
create_clock -name {cmos1_pclk} [get_ports {cam_clk[0]}] -period {11.905} -waveform {0 5.952}
create_clock -name {cmos2_pclk} [get_ports {cam_clk[1]}] -period {11.905} -waveform {0 5.952}
create_clock -name {cmos3_pclk} [get_ports {cam_clk[2]}] -period {20.833} -waveform {0 10.416}
create_clock -name {cmos4_pclk} [get_ports {cam_clk[3]}] -period {20.833} -waveform {0 10.416}
