+        rx_retire_axi_rst2 <= 1'b1;
+    end else begin
+        rx_retire_axi_rst1 <= 1'b0;
+        rx_retire_axi_rst2 <= rx_retire_axi_rst1;
+    end
+end
+always @(posedge fifo_pcie_clk or posedge rx_retirement_epoch_rst) begin
+    if (rx_retirement_epoch_rst) begin
