####### Compile

main.o: ../../src/main.cpp ../../src/vision_types.h \
		../../src/vision_pipeline.h \
		../../src/template_tracker.h \
		../../src/camera_dma.h \
		../../src/frame_metrics.h \
		../../src/display_perf.h \
		../../src/hdmi_view.h \
		../../src/calibration_capture.h \
		../../src/stereo_demo/stereo_depth.h \
		../../src/rknn_api.h \
		../../src/viewer_native_qt.hpp \
		../../src/viewer_native_guard.hpp \
		../../src/raw_dfl_native.h \
		main.moc
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../src/main.cpp

vision_pipeline.o: ../../src/vision_pipeline.cpp ../../src/vision_pipeline.h \
		../../src/vision_types.h \
		../../src/template_tracker.h \
		../../src/stereo_demo/stereo_depth.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o vision_pipeline.o ../../src/vision_pipeline.cpp

