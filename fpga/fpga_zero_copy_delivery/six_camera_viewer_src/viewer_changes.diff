+    struct ThumbnailTransport {
+        PangoDev& dev;
+        qint64 &dmaNs, &copyNs, &capturedMs, &capturedNs;
+        bool read(uint32_t offset, uint32_t& value) {
+            return dev.cameraTagLocked(thumbnail::Base + offset, value);
+        }
+        bool write(uint32_t offset, uint32_t value) {
+            std::memset(dev.tx_, 0, 16);
+            std::memcpy(dev.tx_, &value, sizeof(value));
+            DmaOp op{};
+            op.ddr3_addr = thumbnail::Base + offset; op.total_length = 16;
