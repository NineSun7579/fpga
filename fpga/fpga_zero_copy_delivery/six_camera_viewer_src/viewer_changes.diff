+        bool readTag(uint32_t address, uint32_t& tag) { return dev.cameraTagLocked(address, tag); }
+        bool readPixels(uint32_t address, uint32_t count, void* output) {
+            bool validDestination = false;
+            for (const auto& banks : thumbnail::Destinations)
+                for (auto destination : banks) validDestination |= address == destination;
+            if (!validDestination || count != thumbnail::Bytes || !output) return false;
+            DmaOp op{};
+            op.offset_addr = sixdma::RawSlot;
+            op.ddr3_addr = address; op.total_length = count;
+            QElapsedTimer timer; timer.start();
+            if (dev.ioctlTmo(F2H_CMD, &op, 2) != 0) return false;
