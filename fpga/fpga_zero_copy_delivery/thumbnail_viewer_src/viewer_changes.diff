+    // Same fd, RX slots and mutex as all six RAW workers. No second provider.
+    int thumbnailRead(void* output, size_t capacity, uint32_t& tag,
+                      qint64& dmaNs, qint64& copyNs, qint64& capturedMs, qint64& capturedNs) {
+        QMutexLocker lock(&dmaMutex_);
+        ThumbnailTransport transport{*this, dmaNs, copyNs, capturedMs, capturedNs};
+        thumbnail::Reader<ThumbnailTransport> reader(transport);
+        reader.read(output, capacity, tag);
+        return 1;
+    }
+
     const char *lastErr() const { return err_; }
 
 private:
+    struct ThumbnailTransport {
+        PangoDev& dev;
+        qint64 &dmaNs, &copyNs, &capturedMs, &capturedNs;
+        bool read(uint32_t offset, uint32_t& value) {
+            return dev.cameraTagLocked(thumbnail::Base + offset, value);
+        }
+        bool write(uint32_t offset, uint32_t value) {
+            std::memset(dev.tx_, 0, 16);
+            std::memcpy(dev.tx_, &value, sizeof(value));
+            DmaOp op{};
+            op.ddr3_addr = thumbnail::Base + offset; op.total_length = 16;
+            return dev.ioctlTmo(H2F_CMD, &op, 2) == 0;
+        }
+        bool readTag(uint32_t address, uint32_t& tag) { return dev.cameraTagLocked(address, tag); }
+        bool readPixels(uint32_t address, uint32_t count, void* output) {
+            if (address != thumbnail::ThumbDestination || count != thumbnail::Bytes || !output) return false;
+            DmaOp op{};
+            op.offset_addr = tdm::cameraSlotOffset(4);
+            op.ddr3_addr = address; op.total_length = count;
+            QElapsedTimer timer; timer.start();
+            if (dev.ioctlTmo(F2H_CMD, &op, 2) != 0) return false;
+            dmaNs = timer.nsecsElapsed();
+            capturedMs = monotonicMs();
+            capturedNs = monotonicNs(); // Same metric start as RAW: host DMA return.
+            if (op.total_length != count || op.offset_addr != tdm::cameraSlotOffset(4)) return false;
+            timer.restart();
+            tdm::copyCameraPixels(output, dev.rx_ + op.offset_addr, count);
+            copyNs = timer.nsecsElapsed();
+            return true;
+        }
+        int64_t nowMs() { return monotonicMs(); }
+        void delay() { QThread::msleep(1); }
+        [[noreturn]] void quarantine(const char* reason) {
+            dev.quarantine(reason);
+        }
+    };
