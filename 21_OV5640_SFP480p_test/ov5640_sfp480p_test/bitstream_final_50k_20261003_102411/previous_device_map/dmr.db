    <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
        <column_headers>
            <data>Command</data>
        </column_headers>
        <row>
            <data>create_clock -name {sys_clk} [get_ports {sys_clk}] -period {20.000} -waveform {0.000 10.000}</data>
        </row>
        <row>
            <data>create_clock -name {cmos1_pclk} [get_ports {cmos1_pclk}] -period {11.900} -waveform {0.000 5.950}</data>
        </row>
        <row>
            <data>create_clock -name {cmos2_pclk} [get_ports {cmos2_pclk}] -period {11.900} -waveform {0.000 5.950}</data>
        </row>
        <row>
            <data>create_generated_clock -name {cmos1_pclk_16bit} -source [get_ports {cmos1_pclk}] [get_pins {cmos1_8_16bit/pixel_clk}] -master_clock [get_clocks {cmos1_pclk}] -divide_by {2}</data>
        </row>
        <row>
            <data>create_generated_clock -name {cmos2_pclk_16bit} -source [get_ports {cmos2_pclk}] [get_pins {cmos2_8_16bit/pixel_clk}] -master_clock [get_clocks {cmos2_pclk}] -divide_by {2}</data>
        </row>
        <row>
            <data>create_generated_clock -name {pix_clk} -source [get_ports {sys_clk}] [get_pins {u_pll.u_pll_e3/CLKOUT0}] -master_clock [get_clocks {sys_clk}] -multiply_by {49} -divide_by {66}</data>
        </row>
        <row>
            <data>create_generated_clock -name {cfg_clk} -source [get_ports {sys_clk}] [get_pins {u_pll.u_pll_e3/CLKOUT1}] -master_clock [get_clocks {sys_clk}] -multiply_by {49} -divide_by {246}</data>
        </row>
        <row>
            <data>create_generated_clock -name {clk_25M} -source [get_ports {sys_clk}] [get_pins {u_pll.u_pll_e3/CLKOUT2}] -master_clock [get_clocks {sys_clk}] -divide_by {2}</data>
        </row>
        <row>
            <data>create_generated_clock -name {cam1_sccb} -source [get_pins {u_pll.u_pll_e3/CLKOUT2}] [get_pins {coms1_reg_config.clock_20k}] -master_clock [get_clocks {clk_25M}] -divide_by {2500}</data>
        </row>
        <row>
            <data>create_generated_clock -name {cam2_sccb} -source [get_pins {u_pll.u_pll_e3/CLKOUT2}] [get_pins {coms2_reg_config.clock_20k}] -master_clock [get_clocks {clk_25M}] -divide_by {2500}</data>
        </row>
        <row>
            <data>create_clock -name {p_clk2core_tx_2} [get_pins {u_hsst.o_p_clk2core_tx_2}] -period {8.000} -waveform {0.000 4.000}</data>
        </row>
        <row>
            <data>create_generated_clock -name {mrg_clk} -source [get_pins {u_hsst.o_p_clk2core_tx_2}] [get_nets {mrg_clk}] -master_clock [get_clocks {p_clk2core_tx_2}] -edges {2 4 6}</data>
        </row>
        <row>
            <data>set_clock_groups -name independent_clock_families -asynchronous -group [get_clocks {sys_clk pix_clk cfg_clk clk_25M cam1_sccb cam2_sccb}] -group [get_clocks {cmos1_pclk cmos1_pclk_16bit}] -group [get_clocks {cmos2_pclk cmos2_pclk_16bit}] -group [get_clocks {p_clk2core_tx_2 mrg_clk}]</data>
        </row>
        <row>
            <data>set_clock_uncertainty {0.200} [get_clocks {cmos1_pclk_16bit}]  -setup -hold</data>
        </row>
        <row>
            <data>set_clock_uncertainty {0.200} [get_clocks {cmos2_pclk_16bit}]  -setup -hold</data>
        </row>
        <row>
            <data>set_clock_uncertainty {0.200} [get_clocks {cmos1_pclk}]  -setup -hold</data>
        </row>
        <row>
            <data>set_clock_uncertainty {0.200} [get_clocks {cmos2_pclk}]  -setup -hold</data>
        </row>
    </table>
