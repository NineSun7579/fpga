//心跳信号
     // [SLIM Rev3.2] 心跳改 sys_clk 域(原 core_clk 随 DDR 链停用), 1Hz 闪烁=程序活着
     always@(posedge sys_clk) begin
        if (!rstn_int)
            cnt <= 27'd0;
        else if ( cnt >= TH_1S )
            cnt <= 27'd0;
        else
            cnt <= cnt + 27'd1;
     end

     // [DIAG Rev3.2f] 原 1Hz 心跳让位: C5 = RX 收到的字 == 32'h55a101bc
     always @(posedge sys_clk or negedge rstn_int)
     begin
         if (!rstn_int)
             heart_beat_led <= 1'b0;
         else
             heart_beat_led <= s_dir_left[1];                   // C5 = 方向判定(1=左旋 rotl)
     end

/////////////////////////////////////////////////////////////////////////////////////
endmodule
